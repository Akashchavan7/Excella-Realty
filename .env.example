# Public site URL used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.excellaa.com

# CRM integration boundary (see src/lib/crm). "log" prints leads to the server log;
# "webhook" POSTs each validated lead as JSON to CRM_WEBHOOK_URL.
CRM_PROVIDER=log
CRM_WEBHOOK_URL=
CRM_WEBHOOK_TOKEN=
